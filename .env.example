# === Banco de mercado (sinais, runs, candidatos, aprendizado) ===
# Turso/libSQL: cada operação trafega só as linhas necessárias (sem despachar
# o arquivo inteiro), o que elimina o estouro de egress do modelo antigo.
# Crie o banco em https://turso.tech e gere a URL + token:
#   turso db create market-sentinel
#   turso db show market-sentinel --url        -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create market-sentinel     -> TURSO_AUTH_TOKEN
# Se estas duas ficarem vazias, o app cai para um SQLite local (DATABASE_PATH),
# que em ambiente serverless/efêmero volta a zero a cada cold start.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Caminho do SQLite local (fallback quando o Turso não está configurado).
DATABASE_PATH=
SESSION_SECRET=
SESSION_COOKIE_SECURE=auto

# === Login Web3 / usuários / chat (independente do banco de mercado) ===
# Continua no Supabase Postgres (PostgREST). Só é necessário para o social.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === VIP (10 USDC na Solana = 31 dias de acesso às oportunidades qualificadas) ===
# Carteira Solana que recebe os USDC. Ela precisa já ter a conta de USDC criada
# (basta ter recebido USDC uma vez); o botão Phantom também a cria se faltar.
VIP_TREASURY_WALLET=
VIP_PRICE_USDC=10
VIP_DAYS=31
# RPC usado para confirmar pagamentos. Vazio = Helius (se HELIUS_API_KEY) ou RPC público.
SOLANA_RPC_URL=
# Carteiras Solana sempre VIP (as do login), separadas por vírgula — ex.: a sua.
VIP_ADMIN_WALLETS=

JUPITER_API_KEY=
BIRDEYE_API_KEY=
HELIUS_API_KEY=
HELIUS_WEBHOOK_URL=
HELIUS_WEBHOOK_SECRET=
HELIUS_WEBHOOK_ID=
SOLANA_INTEL_MAX_TOKENS=30
SOLANA_INTEL_MAX_WALLETS=50
SOLANA_INTEL_MONITOR_WALLETS=25
SOLANA_INTEL_PURCHASE_HISTORY_LIMIT=200
SOLANA_INTEL_HISTORY_LIMIT=500
SOLANA_INTEL_HISTORY_HOURS=24
SOLANA_INTEL_REANALYZE_SECONDS=21600
SOLANA_INTEL_WALLET_CACHE_SECONDS=21600
SOLANA_INTEL_MAX_CONCURRENCY=4
# Rate limit / performance da Birdeye e divisão web x worker:
SOLANA_INTEL_ENRICH_ON_READ=true            # no Vercel use false (só leitura do Supabase)
SOLANA_INTEL_BIRDEYE_MIN_INTERVAL_SECONDS=1.2
SOLANA_INTEL_BIRDEYE_MAX_RETRIES=4
SOLANA_INTEL_ANALYSIS_BATCH=8
SOLANA_INTEL_WALLET_AUDIT_BATCH=12
SOLANA_INTEL_BIRDEYE_WALLET_TAGS=            # vazio = sem filtro server-side (recomendado); ex: smart_trader
SOLANA_INTEL_HISTORY_OBJECT=solana-intel-history.json
SOLANA_INTEL_MIN_LIQUIDITY_USD=2000
SOLANA_INTEL_MIN_TOKEN_SAFETY=60
SOLANA_INTEL_MIN_ORGANIC_SCORE=0
SOLANA_INTEL_MIN_PROFITABLE_MEMECOINS=3
SOLANA_INTEL_MIN_OPPORTUNITY_SCORE=50
# Caminho alternativo de qualificação de carteira (track record 90d Birdeye):
SOLANA_INTEL_MIN_PNL_QUALIFYING_USD=5000
SOLANA_INTEL_MIN_PNL_WIN_RATE=40
SOLANA_INTEL_MIN_PNL_OUTCOMES=8
SOLANA_INTEL_MIN_PNL_PROFITABLE_MEMECOINS=1
SOLANA_INTEL_CACHE_SECONDS=300
